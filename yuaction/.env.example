POSTGRES_PASSWORD=
YUACTION_CREATOR_KEY=
YUFOLO_INGEST_KEY=
# DreamTrans backend base URL; discovered automatically in --dreamtrans-dir mode.
YUFOLO_URL=
YUACTION_DEMO=false
APP_BIND=127.0.0.1
APP_PORT=11452
IMAGE_TAG=latest
# IMAGE_PREFIX=ghcr.io/coyumelabs/dreamtrans-yuaction

# Standalone AI only. When YUFOLO_URL is set, AI/knowledge use that account's
# Yufolo APIs, approved models and billing instead; no second API key is needed.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional separate full endpoint URLs / embedding credentials:
# OPENAI_API_URL=
# OPENAI_EMBEDDING_API_URL=
# OPENAI_EMBEDDING_API_KEY=
