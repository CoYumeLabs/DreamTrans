# Git
.git
.gitignore

# Documentation
*.md
LICENSE

# Development files
.env
*.log
*.logs

# Node modules (will be installed fresh in Docker)
**/node_modules
**/.vite
**/dist

# Go build artifacts
backend/server
backend/*.exe
backend/*.test
backend/*.out

# IDE files
.vscode
.idea
*.swp
*.swo

# Test files
**/test*
**/*test*
# The production image still excludes tests. This single build-tagged source is
# admitted so the CI-only extraction conformance binary can be compiled in a
# separate scratch export stage.
!backend/internal/handlers/knowledge_extraction_linux_integration_test.go
!backend/internal/edgeruntime/*_test.go

# GitHub
.github

# Docker files themselves
Dockerfile*
docker-compose*.yml
