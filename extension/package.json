{
  "name": "dreamtrans-moodle-sync",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-only Moodle sync for DreamTrans: course materials are fetched and extracted inside the user's browser; only derived text reaches the server.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "package": "node build.mjs && node build.mjs --zip",
    "test": "esbuild src/content/privacyVerification.ts --bundle --platform=node --format=esm --outfile=/tmp/dreamtrans-moodle-privacy.mjs && node /tmp/dreamtrans-moodle-privacy.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.2",
    "typescript": "~5.8.3"
  }
}
