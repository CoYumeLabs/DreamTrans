# ============================================
# DreamTrans Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# === Required ===
# Speechmatics API Key (for real-time transcription)
# Get yours at: https://www.speechmatics.com/
SM_API_KEY=
# Optional: a second key from a Speechmatics account with Model Training OFF.
# When set, the training programme is offered: only users who join are routed
# through SM_API_KEY (training on) and get the transcription discount
# (system setting training_discount_percent, default 30); everyone else,
# including anonymous callers, uses this key. Empty = no programme, all
# traffic through SM_API_KEY.
SM_API_KEY_NO_TRAINING=
# In billing mode, compressed batch audio has no trustworthy duration before
# upload. The safe default reserves the full accepted 7-day maximum (10080
# minutes) and atomically refunds the difference after completion. Lowering
# this value explicitly accepts upstream cost exposure.
BATCH_BILLING_RESERVATION_MINUTES=10080
# Direct temporary tokens cannot be metered after they leave the backend and
# are disabled in billing mode. This unsafe compatibility escape hatch is off.
ALLOW_UNMETERED_CLASSIC_TOKEN_WITH_BILLING=false
# Charged only when the unsafe classic-token escape hatch above is enabled.
CLASSIC_TOKEN_BILLING_MINUTES=10

# === OpenAI API (optional, for translation/chat) ===
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Official OpenAI endpoints use Responses and prompt caching by default.
# Prompt caching reduces repeated stable-prefix cost; it does not increase the
# model context window or bypass AI_MAX_CONTEXT_TOKENS.
OPENAI_USE_RESPONSES=true
OPENAI_PROMPT_CACHE=true
OPENAI_PROMPT_CACHE_TTL=1800
# Hard server-side budget across prompt, history, question, transcript and
# retrieved project/session knowledge.
AI_MAX_CONTEXT_TOKENS=256000
# Reserve model-window capacity for generated output. Effective readable input
# is min(AI_MAX_CONTEXT_TOKENS,
# AI_MODEL_CONTEXT_WINDOW_TOKENS - AI_CONTEXT_OUTPUT_RESERVE_TOKENS).
AI_CONTEXT_OUTPUT_RESERVE_TOKENS=4096
AI_MODEL_CONTEXT_WINDOW_TOKENS=260096
# Maximum SQLite RAG database size in MiB; use -1 only for an intentional
# unlimited deployment.
RAG_MAX_DB_MB=102400

# === AI project knowledge and indexing ===
# Raw uploaded files. The root Compose deployment overrides this with the
# persistent /app/data/knowledge path inside the application container.
KNOWLEDGE_DATA_PATH=./data/knowledge
KNOWLEDGE_MAX_FILE_MB=50
# Extraction fails explicitly when any configured boundary is exceeded.
KNOWLEDGE_MAX_EXTRACTED_MB=10
KNOWLEDGE_MAX_OFFICE_UNCOMPRESSED_MB=100
KNOWLEDGE_MAX_IMAGE_MEGAPIXELS=40
KNOWLEDGE_MAX_PDF_PAGES=100
# Fixed PostgreSQL-lease worker pools. Valid runtime range: 1-32.
KNOWLEDGE_EXTRACT_WORKERS=2
AI_INDEX_WORKERS=2

# === Deployment / Server Configuration ===
# In the root Docker Compose file PORT is the host port; the container still
# listens on 8080. When running Go directly, PORT is the server listen port.
BIND_ADDRESS=127.0.0.1
PORT=16002
IMAGE_TAG=latest

# === PostgreSQL (required for Pro features) ===
# Compose derives DATABASE_URL from these values. Keep the password URL-safe
# (for example: openssl rand -hex 32).
POSTGRES_DB=dreamtrans
POSTGRES_USER=dreamtrans
POSTGRES_PASSWORD=
# Only set DATABASE_URL when running the backend outside Docker Compose.
DATABASE_URL=

# === JWT Authentication (required for Pro features) ===
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# === Bootstrap Administrator (configure both or neither) ===
# Required for a fresh Pro database unless self-registration is deliberately
# enabled. Existing installations with an administrator may leave both blank.
# ADMIN_PASSWORD must be at least 16 characters. No default account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# === API Authentication ===
# Single-user/API deployments should generate a service key and send it as
# X-DreamTrans-API-Key. Keep anonymous mode false on network-accessible hosts.
DREAMTRANS_API_KEY=
DREAMTRANS_ADMIN_API_KEY=
ALLOW_ANONYMOUS_API=false
# Legacy JWTs in WebSocket URL query strings can leak through logs. Modern
# clients use Sec-WebSocket-Protocol; enable this only during a phased upgrade.
ALLOW_WEBSOCKET_QUERY_TOKEN=false
API_RATE_LIMIT_PER_MINUTE=120
# Shared by /ws/translate and /ws/speechmatics. Values must be positive.
WEBSOCKET_MAX_CONNECTIONS=256
WEBSOCKET_MAX_CONNECTIONS_PER_PRINCIPAL=4

# === Registration ===
# Self-registration is disabled unless explicitly enabled. An invite code is
# optional but recommended whenever registration is exposed to the internet.
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=

# Comma-separated cross-origin browser origins. Empty keeps only the built-in
# local development origins; same-origin requests do not require CORS.
CORS_ALLOWED_ORIGINS=

# === PCAS Event Worker (backend/Dockerfile.event) ===
# Loopback defaults to plaintext. Non-loopback PCAS_ADDR uses TLS unless
# PCAS_INSECURE=true is explicitly set.
PCAS_ADDR=127.0.0.1:50051
PCAS_INSECURE=false
# Optional custom CA bundle and certificate-name override for PCAS TLS.
PCAS_CA_CERT=
PCAS_TLS_SERVER_NAME=
# Sent as "Authorization: Bearer ..." only over TLS or loopback plaintext.
PCAS_API_KEY=
# Remote audio_url inputs require HTTPS by default. Even when HTTP is enabled,
# private, loopback, link-local, metadata, and other special IPs remain blocked.
AUDIO_URL_ALLOW_HTTP=false

# === PCAS Streaming Provider (backend/Dockerfile.pcas MODE=provider) ===
GRPC_BIND_ADDR=127.0.0.1
GRPC_PORT=50052
# A non-loopback bind requires PCAS_API_KEY (at least 16 characters) and TLS.
PCAS_TLS_CERT=
PCAS_TLS_KEY=
# Emergency compatibility escape hatch; do not use on untrusted networks.
PCAS_ALLOW_INSECURE_REMOTE=false
PCAS_MAX_CONCURRENT_STREAMS=32
PCAS_ENABLE_REFLECTION=false

# === System Settings ===
# Set to 'true' to allow users to use their own API keys
ALLOW_USER_API_KEY=false

# Stripe payments (optional). Leave empty to run without online top-ups and
# membership checkout; administrators can still grant credit by hand.
# Webhook endpoint: POST /api/billing/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public site URL Stripe redirects back to after checkout (defaults to the request host)
APP_BASE_URL=
# Currency Stripe charges in (ISO 4217, default usd). The ledger stays in USD;
# set the rate as units of that currency per 1 USD. Needed e.g. for WeChat Pay
# on an Australian Stripe account, which only settles in AUD.
STRIPE_CURRENCY=usd
# A fixed number, or "auto" to fetch the ECB reference rate hourly.
STRIPE_USD_EXCHANGE_RATE=
# Auto mode only: percent added on top of the reference rate as a safety
# margin, and an optional alternative latest-rates endpoint (Frankfurter API shape).
STRIPE_FX_MARKUP_PERCENT=0
STRIPE_FX_RATE_URL=

# === Debug ===
OPENAI_DEBUG=0

# Signup reward risk: optional independent stable key (at least 32 characters).
# Defaults to JWT_SECRET; configure separately before rotating JWT secrets.
SIGNUP_RISK_SECRET=
# Trust forwarding headers only from explicitly configured reverse proxies.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Optional: provision Edge management without routing ordinary users to Edge.
# Unset preserves existing regional deployments (routing follows the seed).
# Blue-green hosts apply this through dreamtransctl configure-edge --routing
# on|off; editing .env alone does not change running container configuration.
# Cloudflare account API credentials are NOT required for manual Tunnel setup.
# EDGE_ROUTING_ENABLED=false
